/**
 * Household Finance Tracker — Export.gs
 * "Copy financial snapshot for AI": a plain-text briefing of the household's
 * finances — what you would hand a financial advisor — ready to paste into a
 * Claude project. Computed from the raw tables (not from the Dashboard), so
 * it is complete and consistent even if a derived formula is ever off.
 *
 * Contains first names (the Persons list), balances, debts and rates from the
 * owner's own workbook. No account numbers, external IDs or tokens.
 */

function exportSnapshot() {
  const ui = ui_();
  const html = HtmlService.createHtmlOutputFromFile('ExportDialog').setWidth(760).setHeight(640);
  ui.showModalDialog(html, 'Copy financial snapshot for AI');
}

/** Server call for the dialog. */
function getSnapshotText() {
  return buildSnapshotText_(collectSnapshotData_());
}

/* ---------- collection (reads the Sheet) ---------- */

function collectSnapshotData_() {
  const ss = ss_();
  const sampleCell = ss.getRangeByName('SETTING_SAMPLE_PRESENT');
  return {
    asOf: new Date(),
    tz: Session.getScriptTimeZone(),
    persons: HFT.PERSONS,
    samplePresent: sampleCell ? sampleCell.getValue() === true : false,
    income: readTable_(tdef_('INCOME')),
    tx: readTable_(tdef_('TX')),
    accounts: readTable_(tdef_('ACCOUNTS')),
    debts: readTable_(tdef_('DEBTS')),
    qdr: readTable_(tdef_('QDR')),
    funds: readTable_(tdef_('FUNDS')),
    budgets: readTable_(tdef_('BUDGET')),
    plans: readTable_(tdef_('PLAN')),
    recurring: readTable_(tdef_('RECUR')),
    credit: readTable_(tdef_('CREDIT')),
    nw: readTable_(tdef_('NW')),
    staging: readTable_(tdef_('STAGING')),
    reviews: readTable_(tdef_('REVIEW')),
  };
}

/* ---------- pure builder ---------- */

function buildSnapshotText_(d) {
  const L = [];
  const money = (n) => { const v = Number(n || 0); const s = Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); return (v < 0 ? '-$' : '$') + s; };
  const pct = (n) => (n === '' || n === null || n === undefined || isNaN(Number(n))) ? '—' : (Number(n) * 100).toFixed(1) + '%';
  const mk = (dt) => (dt instanceof Date) ? dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') : '';
  const monthName = (key) => { const [y, m] = key.split('-').map(Number); return new Date(y, m - 1, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' }); };
  const dateStr = (dt) => (dt instanceof Date) ? dt.toISOString().slice(0, 10) : (dt ? String(dt) : '—');
  const sum = (rows, f) => rows.reduce((s, r) => s + Number(f(r) || 0), 0);
  // Derive everything from entered columns, never from formula columns (so the snapshot is right even if a formula is off).
  const live = d.tx.filter(t => t.isDeleted !== true);
  d.income.forEach(r => { r._month = mk(r.payDate instanceof Date ? r.payDate : r.month); r._take = Number(r.gross || 0) - ['fedTax', 'stateTax', 'ssMed', 'health', 'retirement', 'otherDed'].reduce((s, k) => s + Number(r[k] || 0), 0); });
  live.forEach(t => { t._month = mk(t.date instanceof Date ? t.date : t.month); });
  const today = d.asOf;
  const curKey = mk(new Date(today.getFullYear(), today.getMonth(), 1));
  const months = [];
  for (let i = 5; i >= 0; i--) months.push(mk(new Date(today.getFullYear(), today.getMonth() - i, 1)));
  const lastFull = months[months.length - 2];
  const inMonth = (rows, key) => rows.filter(r => r._month === key);

  L.push('# Household Finance Snapshot');
  L.push('As of ' + dateStr(today) + ' · generated by the Household Finance Tracker (Google Sheets). Household: ' + d.persons.join(' and ') + '.');
  if (d.samplePresent) L.push('**Note: this workbook still contains SAMPLE data (rows tagged SAMPLE). Figures below mix sample and real entries until Clear sample data has been run.**');
  L.push('Conventions: months are calendar months; Spending = expenses − refunds (transfers, savings allocations, debt payments and split parents are not spending); Income is take-home from paychecks unless marked gross; debts are the latest reviewed balances; student loans are reported separately from household debt.');
  L.push('');

  /* Income */
  L.push('## Income (paychecks)');
  L.push('| Month | Gross | Take-home | ' + d.persons.map(p => p + ' take-home').join(' | ') + ' | Payroll retirement | Payroll health |');
  L.push('|---|---:|---:|' + d.persons.map(() => '---:').join('|') + '|---:|---:|');
  const incMonths = months.filter(m => inMonth(d.income, m).length);
  incMonths.forEach(m => {
    const rows = inMonth(d.income, m);
    L.push('| ' + monthName(m) + ' | ' + money(sum(rows, r => r.gross)) + ' | ' + money(sum(rows, r => r._take)) + ' | ' + d.persons.map(p => money(sum(rows.filter(r => r.person === p), r => r._take))).join(' | ') + ' | ' + money(sum(rows, r => r.retirement)) + ' | ' + money(sum(rows, r => r.health)) + ' |');
  });
  const fullIncMonths = incMonths.filter(m => m !== curKey);
  if (fullIncMonths.length) {
    const avgTake = sum(fullIncMonths, m => sum(inMonth(d.income, m), r => r._take)) / fullIncMonths.length;
    const avgGross = sum(fullIncMonths, m => sum(inMonth(d.income, m), r => r.gross)) / fullIncMonths.length;
    L.push('');
    L.push('Average over the last ' + fullIncMonths.length + ' full month(s): gross ' + money(avgGross) + ', take-home ' + money(avgTake) + ' (' + pct(avgGross ? avgTake / avgGross : '') + ' of gross).');
  }
  const employers = {};
  d.income.forEach(r => { const k = r.person + ' · ' + r.employer + ' · ' + r.incomeType; employers[k] = (employers[k] || 0) + 1; });
  if (Object.keys(employers).length) L.push('Sources: ' + Object.keys(employers).map(k => k + ' (' + employers[k] + ' paychecks)').join('; ') + '.');
  L.push('');

  /* Cash flow by month */
  L.push('## Monthly cash flow');
  L.push('| Month | Take-home | Spending | Cash savings | Debt payments | Cash remaining | Cash savings rate | Total savings incl. payroll retirement |');
  L.push('|---|---:|---:|---:|---:|---:|---:|---:|');
  months.forEach(m => {
    const inc = sum(inMonth(d.income, m), r => r._take);
    const txm = inMonth(live, m);
    const spend = sum(txm.filter(t => t.type === 'Expense'), t => t.amount) - sum(txm.filter(t => t.type === 'Refund'), t => t.amount);
    const sav = sum(txm.filter(t => t.type === 'Savings'), t => t.amount);
    const debt = sum(txm.filter(t => t.type === 'Debt Payment'), t => t.amount);
    const ret = sum(inMonth(d.income, m), r => r.retirement);
    if (!inc && !txm.length) return;
    L.push('| ' + monthName(m) + (m === curKey ? ' (to date)' : '') + ' | ' + money(inc) + ' | ' + money(spend) + ' | ' + money(sav) + ' | ' + money(debt) + ' | ' + money(inc - spend - sav - debt) + ' | ' + pct(inc ? sav / inc : '') + ' | ' + money(sav + ret) + ' |');
  });
  L.push('');

  /* Spending by category */
  const catMonths = months.slice(-4, -1); // last three full months
  L.push('## Spending by category');
  L.push('Last full month (' + monthName(lastFull) + ') and the average of the last ' + catMonths.length + ' full months. Expenses minus refunds; soft-deleted rows excluded.');
  L.push('| Category | ' + monthName(lastFull) + ' | ' + catMonths.length + '-month average | Share (avg) |');
  L.push('|---|---:|---:|---:|');
  const catTotals = {};
  const net = (rows) => sum(rows.filter(t => t.type === 'Expense'), t => t.amount) - sum(rows.filter(t => t.type === 'Refund'), t => t.amount);
  const cats = {};
  live.filter(t => (t.type === 'Expense' || t.type === 'Refund') && catMonths.indexOf(t._month) >= 0).forEach(t => { cats[t.category || '(uncategorized)'] = true; });
  const avgTotal = sum(catMonths, m => net(inMonth(live, m))) / Math.max(catMonths.length, 1);
  Object.keys(cats).map(c => {
    const lastV = net(inMonth(live, lastFull).filter(t => (t.category || '(uncategorized)') === c));
    const avgV = sum(catMonths, m => net(inMonth(live, m).filter(t => (t.category || '(uncategorized)') === c))) / Math.max(catMonths.length, 1);
    catTotals[c] = avgV;
    return { c, lastV, avgV };
  }).sort((a, b) => b.avgV - a.avgV).forEach(r => L.push('| ' + r.c + ' | ' + money(r.lastV) + ' | ' + money(r.avgV) + ' | ' + pct(avgTotal ? r.avgV / avgTotal : '') + ' |'));
  L.push('| **Total** | ' + money(net(inMonth(live, lastFull))) + ' | ' + money(avgTotal) + ' | 100% |');
  L.push('');
  L.push('By spending type (' + catMonths.length + '-month average): ' + ['Fixed', 'Flexible', 'Planned Irregular', 'Unexpected'].map(stp => stp + ' ' + money(sum(catMonths, m => net(inMonth(live, m).filter(t => t.spendingType === stp))) / Math.max(catMonths.length, 1))).join(' · ') + '.');
  const topSub = {};
  live.filter(t => t.type === 'Expense' && catMonths.indexOf(t._month) >= 0 && t.subcategory).forEach(t => { const k = t.category + ' / ' + t.subcategory; topSub[k] = (topSub[k] || 0) + Number(t.amount); });
  const top = Object.keys(topSub).map(k => ({ k, v: topSub[k] / Math.max(catMonths.length, 1) })).sort((a, b) => b.v - a.v).slice(0, 10);
  if (top.length) L.push('Largest subcategories (monthly average): ' + top.map(t => t.k + ' ' + money(t.v)).join('; ') + '.');
  L.push('');

  /* Flexible plan & budget */
  const plan = d.plans.filter(p => mk(p.month) === curKey)[0];
  const flexSpent = net(inMonth(live, curKey).filter(t => t.spendingType === 'Flexible'));
  L.push('## This month\'s plan (' + monthName(curKey) + ', to date)');
  if (plan) L.push('Flexible-spending target ' + money(plan.target) + '; flexible spent so far ' + money(flexSpent) + '; available ' + money(Number(plan.target || 0) - flexSpent) + '.');
  else L.push('No flexible-spending target set for this month yet; flexible spent so far ' + money(flexSpent) + '.');
  const bud = d.budgets.filter(b => mk(b.month) === curKey && b.category);
  if (bud.length) {
    L.push('');
    L.push('| Budget category | Planned | Actual to date | Remaining |');
    L.push('|---|---:|---:|---:|');
    bud.forEach(b => { const a = net(inMonth(live, curKey).filter(t => t.category === b.category)); L.push('| ' + b.category + ' | ' + money(b.planned) + ' | ' + money(a) + ' | ' + money(Number(b.planned || 0) - a) + ' |'); });
    L.push('| **Total** | ' + money(sum(bud, b => b.planned)) + ' | ' + money(sum(bud, b => net(inMonth(live, curKey).filter(t => t.category === b.category)))) + ' | |');
  }
  L.push('');

  /* Savings & reserves */
  L.push('## Savings & reserves (funds)');
  L.push('| Fund | Type | Target | Current | % funded | Target date | Planned monthly | Status |');
  L.push('|---|---|---:|---:|---:|---|---:|---|');
  let fundTotal = 0;
  d.funds.forEach(f => {
    const contrib = sum(live.filter(t => t.fundId === f.id && t.type === 'Savings'), t => t.amount);
    const wd = net(live.filter(t => t.fundId === f.id));
    const cur = Number(f.starting || 0) + contrib - wd;
    fundTotal += cur;
    L.push('| ' + f.name + ' | ' + f.fundType + ' | ' + (f.target ? money(f.target) : '—') + ' | ' + money(cur) + ' | ' + (f.target ? pct(Math.min(cur / Number(f.target), 1)) : '—') + ' | ' + dateStr(f.targetDate) + ' | ' + (f.plannedMonthly ? money(f.plannedMonthly) : '—') + ' | ' + (f.status || '') + ' |');
  });
  L.push('Total held in funds: ' + money(fundTotal) + '.');
  L.push('');

  /* Debts */
  const latestBal = (debt) => { const rows = d.qdr.filter(q => q.debtId === debt.id && q.quarterEnd instanceof Date).sort((a, b) => b.quarterEnd - a.quarterEnd); const q = rows[0]; const end = (q && q.endingBalance !== '' && q.endingBalance !== null) ? Number(q.endingBalance) : (q ? Math.max(Number(q.beginning || 0) - Number(q.payments || 0) + Number(q.interestFees || 0) + Number(q.adjustments || 0), 0) : 0); return rows.length ? { bal: end, asOf: q.quarterEnd } : { bal: Number(debt.originalBalance || 0), asOf: null }; };
  const debtRows = d.debts.map(x => Object.assign({ latest: latestBal(x) }, x));
  const groupOf = (x) => x.group || (x.debtType === 'Student Loan' ? 'Student Loans' : 'Household');
  L.push('## Debts');
  L.push('| Debt | Type | Lender | Owner | Group | Balance | As of | APR | Minimum payment | Est. monthly interest | Target payoff |');
  L.push('|---|---|---|---|---|---:|---|---:|---:|---:|---|');
  debtRows.forEach(x => L.push('| ' + x.name + ' | ' + x.debtType + ' | ' + (x.lender || '') + ' | ' + (x.owner || '') + ' | ' + groupOf(x) + ' | ' + money(x.latest.bal) + ' | ' + (x.latest.asOf ? dateStr(x.latest.asOf) : 'original') + ' | ' + pct(x.apr) + ' | ' + (x.minPayment ? money(x.minPayment) : '—') + ' | ' + money(x.latest.bal * Number(x.apr || 0) / 12) + ' | ' + dateStr(x.targetPayoff) + ' |'));
  const hh = debtRows.filter(x => groupOf(x) !== 'Student Loans'), sl = debtRows.filter(x => groupOf(x) === 'Student Loans');
  L.push('');
  L.push('Household debt (excluding student loans): ' + money(sum(hh, x => x.latest.bal)) + ' · Student loans: ' + money(sum(sl, x => x.latest.bal)) + ' · All debt: ' + money(sum(debtRows, x => x.latest.bal)) + '.');
  L.push('Estimated interest at current balances: ' + money(sum(debtRows, x => x.latest.bal * Number(x.apr || 0) / 12)) + ' per month, ' + money(sum(debtRows, x => x.latest.bal * Number(x.apr || 0))) + ' per year (estimates; lenders accrue daily). Minimum payments total ' + money(sum(debtRows, x => x.minPayment)) + ' per month.');
  const debtPaid3 = sum(catMonths, m => sum(inMonth(live, m).filter(t => t.type === 'Debt Payment'), t => t.amount)) / Math.max(catMonths.length, 1);
  L.push('Actual debt payments averaged ' + money(debtPaid3) + ' per month over the last ' + catMonths.length + ' full months.');
  L.push('');

  /* Accounts & net worth */
  L.push('## Accounts and net worth');
  L.push('| Account | Type | Owner | Balance | Last updated |');
  L.push('|---|---|---|---:|---|');
  const nwAcc = d.accounts.filter(a => a.includeNW === 'Yes');
  d.accounts.forEach(a => L.push('| ' + a.name + ' | ' + a.accountType + ' | ' + (a.owner || '') + ' | ' + (a.currentBalance === '' || a.currentBalance === null ? 'not entered' : money(a.currentBalance)) + ' | ' + dateStr(a.lastUpdated) + ' |'));
  const linked = {}; d.debts.forEach(x => { if (x.linkedAccount) linked[x.linkedAccount] = true; });
  const assets = sum(nwAcc.filter(a => a.accountType !== 'Credit Card' && a.accountType !== 'Loan'), a => a.currentBalance);
  const unlinkedCC = sum(nwAcc.filter(a => (a.accountType === 'Credit Card' || a.accountType === 'Loan') && !linked[a.id]), a => a.currentBalance);
  const debtTotal = sum(debtRows, x => x.latest.bal);
  L.push('');
  L.push('Tracked assets ' + money(assets) + ' − credit-card/loan balances not in Debts ' + money(unlinkedCC) + ' − reviewed debts ' + money(debtTotal) + ' = **tracked net worth ' + money(assets - unlinkedCC - debtTotal) + '** (excluding student loans: ' + money(assets - unlinkedCC - sum(hh, x => x.latest.bal)) + ').');
  const byType = {}; nwAcc.forEach(a => { byType[a.accountType] = (byType[a.accountType] || 0) + Number(a.currentBalance || 0); });
  L.push('By account type: ' + Object.keys(byType).map(t => t + ' ' + money(byType[t])).join(' · ') + '.');
  const snaps = d.nw.filter(n => n.month instanceof Date).sort((a, b) => a.month - b.month);
  if (snaps.length) L.push('Net-worth snapshots: ' + snaps.slice(-6).map(n => monthName(mk(n.month)) + ' ' + money(Number(n.cash || 0) + Number(n.savings || 0) + Number(n.retirement || 0) + Number(n.investments || 0) + Number(n.property || 0) + Number(n.otherDeprecated || 0) - Number(n.totalDebt || 0))).join('; ') + '.');
  L.push('');

  /* Recurring obligations */
  const freqFactor = { Weekly: 52 / 12, Biweekly: 26 / 12, Monthly: 1, Quarterly: 1 / 3, Semiannual: 1 / 6, Annual: 1 / 12 };
  const rec = d.recurring.filter(r => r.active === true && r.amount !== '');
  L.push('## Recurring obligations (active)');
  L.push('| Name | Group | Category | Amount | Frequency | Monthly equivalent | Auto-pay |');
  L.push('|---|---|---|---:|---|---:|---|');
  rec.forEach(r => L.push('| ' + r.name + ' | ' + (r.group || '') + ' | ' + [r.category, r.subcategory].filter(Boolean).join(' / ') + ' | ' + money(r.amount) + ' | ' + (r.frequency || '') + ' | ' + money(Number(r.amount) * (freqFactor[r.frequency] || 1)) + ' | ' + (r.autoPay === true ? 'yes' : 'no') + ' |'));
  const recMonthly = sum(rec, r => Number(r.amount) * (freqFactor[r.frequency] || 1));
  L.push('Total recurring: ' + money(recMonthly) + ' per month (' + money(recMonthly * 12) + ' per year); subscriptions ' + money(sum(rec.filter(r => r.group === 'Subscriptions'), r => Number(r.amount) * (freqFactor[r.frequency] || 1))) + ' per month.');
  L.push('');

  /* Credit scores */
  L.push('## Credit scores (latest entered)');
  d.persons.forEach(p => {
    const rows = d.credit.filter(c => c.person === p && c.scoreDate instanceof Date && c.score !== '').sort((a, b) => b.scoreDate - a.scoreDate);
    L.push('- ' + p + ': ' + (rows.length ? rows[0].score + ' (' + [rows[0].scoreModel, rows[0].bureau].filter(Boolean).join(', ') + ', ' + dateStr(rows[0].scoreDate) + ')' : 'no score entered yet'));
  });
  L.push('');

  /* Recent reviews */
  const revs = d.reviews.filter(r => r.month instanceof Date && (r.wentWell || r.adjust || r.focus)).sort((a, b) => b.month - a.month).slice(0, 3);
  if (revs.length) {
    L.push('## Recent monthly review notes');
    revs.forEach(r => L.push('- ' + monthName(mk(r.month)) + ' (' + (r.status || '') + '): went well — ' + (r.wentWell || '—') + '; adjust — ' + (r.adjust || '—') + '; focus — ' + (r.focus || '—')));
    L.push('');
  }

  /* Data quality */
  const waiting = d.staging.filter(s => s.status === 'Needs Review' || s.status === 'Needs Split').length;
  const flagged = live.filter(t => t.validationFlag).length;
  const uncategorized = live.filter(t => (t.type === 'Expense' || t.type === 'Refund') && !t.category).length;
  const unlinkedPay = d.income.filter(i => i.linkedTx === 'Unlinked').length;
  L.push('## Data quality notes');
  L.push('- Transactions on record: ' + live.length + ' (' + (d.tx.length - live.length) + ' soft-deleted and excluded).');
  L.push('- Imported rows awaiting review: ' + waiting + '. Transactions with validation flags: ' + flagged + ' (uncategorized: ' + uncategorized + ').');
  L.push('- Paychecks without a matching bank deposit on record: ' + unlinkedPay + ' of ' + d.income.length + '.');
  const noBal = d.accounts.filter(a => a.currentBalance === '' || a.currentBalance === null).length;
  if (noBal) L.push('- Accounts without a balance entered: ' + noBal + ' (net worth is understated by whatever they hold).');
  const noReview = debtRows.filter(x => !x.latest.asOf).length;
  if (noReview) L.push('- Debts with no Quarterly Debt Review yet (balance shown is the original balance): ' + noReview + '.');
  L.push('');
  L.push('_End of snapshot._');
  return L.join('\n');
}
